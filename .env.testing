APP_NAME="All Academies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://allacademies.test
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=allacademies.test

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


ENABLE_OTP=false
DEBUGBAR_ENABLED=false
ENABLE_IMPORTERS=false


OPENAI_API_KEY=
OPENAI_PREMIUM_API_KEY=

OPENAI_DEFAULT_MODEL=gpt-4.1-nano
OPENAI_PREMIUM_MODEL=gpt-4.1-nano
OPENAI_TTS_MODEL=gpt-4o-mini-tts

PAYSTACK_ENV=development
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=



# BigBlueButton Configuration
BBB_SERVER_URL=
BBB_SECRET=your-bbb-secret-key
