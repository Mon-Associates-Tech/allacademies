{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-imagick": "*",
        "ext-libxml": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "akaunting/laravel-firewall": "^3.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "bigbluebutton/bigbluebutton-api-php": "^2.3",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "brick/money": "^0.11.2",
        "doctrine/dbal": "^3.7",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/image": "^3.11",
        "jenssegers/agent": "^2.6",
        "lab404/laravel-impersonate": "*",
        "laravel/framework": "^12.0",
        "laravel/reverb": "*",
        "laravel/sanctum": "*",
        "laravel/telescope": "^5.7",
        "league/commonmark": "^2.10",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^3.6",
        "maatwebsite/excel": "^4.0@dev",
        "openai-php/laravel": "^0.20.0",
        "phpoffice/phpword": "^1.3",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "smalot/pdfparser": "^2.12",
        "spatie/browsershot": "^5.4",
        "spatie/laravel-activitylog": "^4.10",
        "stevebauman/location": "^7.5",
        "symfony/console": "^7.2.0",
        "symfony/mailgun-mailer": "^7.0",
        "tinymce/tinymce": "^7.8"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-m5cs-t1y6-qpcs",
                    "PKSA-3r5d-mb8f-1qw9",
                    "PKSA-mdq4-51ck-6kdq"
                ]
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
