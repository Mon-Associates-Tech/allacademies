APP_NAME="All Academies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://allacademies.test
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=allacademies #alltest
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=allacademies.test

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#MAIL_MAILER=
#MAIL_HOST=
#MAIL_PORT=
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_ENCRYPTION=
#MAIL_FROM_ADDRESS=
#MAIL_FROM_NAME="${APP_NAME}"

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="paps.dev@localhost.me"
MAIL_FROM_NAME="${APP_NAME}"

# Enable or disable email sending across the entire application
# When set to false, emails will be logged but not sent
EMAIL_SENDING_ENABLED=true


#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=
#AWS_BUCKET=
#AWS_USE_PATH_STYLE_ENDPOINT=true
#AWS_ENDPOINT=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


ENABLE_OTP=false
DEBUGBAR_ENABLED=false
ENABLE_IMPORTERS=false


OPENAI_API_KEY=
OPENAI_PREMIUM_API_KEY=

OPENAI_DEFAULT_MODEL=
OPENAI_PREMIUM_MODEL=
OPENAI_TTS_MODEL=

PAYSTACK_ENV=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=

SPECIAL_ACCESS_EMAILS=
GENERAL_EXAMS_ACCESS_ROLES=admin,owner,teacher

BBB_SERVER_URL=
BBB_SECRET=

# ── Proctoring ────────────────────────────────────────────────────────────────
# Master driver: basic (default)
PROCTORING_DRIVER=basic

# Per-violation toggles (set to false to disable)
PROCTOR_TAB_SWITCH=true
PROCTOR_WINDOW_BLUR=true
PROCTOR_COPY_ATTEMPT=true
PROCTOR_PASTE_ATTEMPT=true
PROCTOR_RIGHT_CLICK=true
PROCTOR_KEYBOARD_SHORTCUT=true
PROCTOR_FULLSCREEN_EXIT=true
PROCTOR_EXAM_EXIT=true
PROCTOR_MULTIPLE_FACES=true
PROCTOR_NO_FACE=true
PROCTOR_FACE_MISMATCH=true

# Auto-submit on violation thresholds
PROCTOR_AUTO_SUBMIT=true
PROCTOR_HIGH_THRESHOLD=2
PROCTOR_MEDIUM_THRESHOLD=5

FIREWALL_EMAIL_ENABLED=true
FIREWALL_EMAIL_NAME='Laravel Firewall'
FIREWALL_EMAIL_FROM='firewall@mydomain.com'
FIREWALL_EMAIL_TO='admin@mydomain.com'
FIREWALL_EMAIL_QUEUE='default'


CLEANUP_ADMIN_EMAIL=
CLEANUP_ADMIN_ID=
